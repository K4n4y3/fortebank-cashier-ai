# Ключ для жюри: передаётся в заголовке X-API-Key. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Сам ключ НЕ коммитить: .env в .gitignore.
API_KEY=change-me
# Каталог для загруженных видео и результатов
DATA_DIR=./data
# Конвейер анализа: full — настоящая модель (нужен vLLM), dummy — заглушка для отладки API/UI без GPU
PIPELINE=dummy
# Где слушает vLLM (на поде — локально; с ноутбука — через ssh -L 8000:127.0.0.1:8000 ...)
VLLM_API=http://127.0.0.1:8000
VLLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct-FP8
# Сколько видео обрабатывать параллельно; vLLM сам батчит запросы, на L40S проверено 5 одновременно
WORKERS=3
# Бюджет на одно видео с момента загрузки, сек (лимит жюри — 300)
JOB_DEADLINE_SEC=270
# Веб-интерфейс без ключа (по FAQ 27 авторизация в UI не требуется)
UI_OPEN=1
MAX_UPLOAD_MB=200
